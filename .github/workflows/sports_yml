name: Sports edge scan
on:
  schedule:
    - cron: "0 15 * * *"   # ~11am ET: afternoon slates
    - cron: "0 22 * * *"   # ~6pm ET: evening slates
  workflow_dispatch: {}

permissions:
  contents: write

jobs:
  scan:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install cryptography
      - name: Scan for edges and grade picks
        env:
          KALSHI_API_KEY_ID: ${{ secrets.KALSHI_API_KEY_ID }}
          KALSHI_PRIVATE_KEY: ${{ secrets.KALSHI_PRIVATE_KEY }}
          ODDS_API_KEY: ${{ secrets.ODDS_API_KEY }}
        run: python sports_scanner.py
      - name: Commit the card
        run: |
          git config user.name "bot"
          git config user.email "bot@users.noreply.github.com"
          git add sports_picks.csv sports_results.csv sports.html
          git diff --cached --quiet || git commit -m "sports card $(date -u +'%F %H:%M')"
          git pull --rebase
          git push
